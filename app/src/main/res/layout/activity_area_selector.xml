<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Bar with Search -->
    <LinearLayout
        android:id="@+id/topBarArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/card_dark"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google Maps Area &amp; Geofence Selector"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Piliin ang mga lugar na papayagan (Allowed) o ibabawal (Banned / Zero-Click)"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etSearchPlace"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Maghanap sa Google Maps (hal. Tondo, Ermita)..."
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="12sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnSearchPlace"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Hanapin"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/shopee_orange"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Google Map View Fragment -->
    <fragment
        android:id="@+id/googleMapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topBarArea"
        app:layout_constraintBottom_toTopOf="@id/bottomZoneControl" />

    <!-- Bottom Control & Quick Toggle List -->
    <LinearLayout
        android:id="@+id/bottomZoneControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/card_dark"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <RadioGroup
                android:id="@+id/rgZoneType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbBanned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="🚫 Banned (Zero-Click)"
                    android:textColor="@color/red_banned"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/rbAllowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="✅ Allowed (Pasok)"
                    android:textColor="@color/emerald_pass"
                    android:textSize="11sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnSaveAreas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I-save ang Rules"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/emerald_pass"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConfiguredAreasSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Kasulukuyang naka-set: BANNED: Tondo, Gagalangin | ALLOWED: Manila Proper, Malate, Ermita, Sampaloc"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
